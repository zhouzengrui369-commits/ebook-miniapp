/* 全局样式 */
page {
  font-family: "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", Georgia, serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.8;
  font-size: 32rpx;
  transition: background-color 0.4s, color 0.4s;
  overflow-x: hidden;
}

/* 字号 */
page.size-sm { font-size: 28rpx; }
page.size-lg { font-size: 40rpx; }

/* 行距 */
page.spacing-tight { line-height: 1.5; }
page.spacing-wide { line-height: 2.2; }

/* 暗色模式变量回退 */
page {
  --bg: #fdfaf3;
  --bg2: #f5f0e8;
  --text: #2c2416;
  --text2: #5c4a2e;
  --accent: #c4843a;
  --accent2: #7a3a1a;
  --card: #fffbf5;
  --border: #e0d5c0;
  --highlight: #fef3c7;
  --ttsHighlight: #fbbf24;
  --navBg: rgba(253,250,243,0.95);
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --skeletonBase: #e8e0d0;
  --skeletonShine: #f0e8d8;
  --noteBadge: #d4945a;
  --coverBg: linear-gradient(135deg, #8B4513, #A0522D, #D2691E, #CD853F);
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #1a1a2e;
    --bg2: #16213e;
    --text: #e0d7c6;
    --text2: #a09080;
    --accent: #d4945a;
    --accent2: #e0a070;
    --card: #1f2940;
    --border: #2a3550;
    --highlight: #3a3520;
    --ttsHighlight: #b8860b;
    --navBg: rgba(26,26,46,0.95);
    --shadow: 0 2px 12px rgba(0,0,0,0.3);
    --skeletonBase: #2a3550;
    --skeletonShine: #354060;
    --noteBadge: #e0a070;
    --coverBg: linear-gradient(135deg, #0f0f1a, #1a1a2e, #2a1a0a, #1a0a00);
  }
}

/* 按钮基础 */
button {
  background: none;
  padding: 0;
  line-height: 1;
}
button::after { border: none; }

/* 骨架屏 */
.skeleton {
  background: var(--skeletonBase);
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-title { height: 56rpx; width: 60%; margin: 0 auto 24rpx; }
.skeleton-author { height: 36rpx; width: 30%; margin: 0 auto 48rpx; }
.skeleton-summary { height: 160rpx; width: 100%; margin-bottom: 64rpx; }
.skeleton-line { height: 32rpx; width: 100%; margin-bottom: 20rpx; }
.skeleton-line.short { width: 70%; }
.skeleton-line.medium { width: 85%; }
