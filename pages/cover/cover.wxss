.cover {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--coverBg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cover-title {
  font-size: 96rpx;
  color: #fff;
  text-shadow: 0 4rpx 40rpx rgba(0,0,0,0.4);
  text-align: center;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
  white-space: pre-line;
  line-height: 1.3;
}

.cover-subtitle {
  color: rgba(255,255,255,0.85);
  font-size: 40rpx;
  text-align: center;
}

.cover-subtitle-2 {
  color: rgba(255,255,255,0.75);
  font-size: 32rpx;
  text-align: center;
  margin-top: 24rpx;
}

.cover-hint {
  position: absolute;
  bottom: 120rpx;
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
