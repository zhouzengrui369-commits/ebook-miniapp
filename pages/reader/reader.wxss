/* 状态栏 */
.status-bar {
  height: var(--status-bar-height, 44px);
  width: 100%;
  background: var(--navBg);
}

/* 导航栏 */
.nav-bar {
  height: 88rpx;
  background: var(--navBg);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border-bottom: 1px solid var(--border);
  z-index: 100;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nav-title {
  font-weight: bold;
  color: var(--accent2);
  font-size: 28rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-left: 12rpx;
}

.nav-btn {
  background: none;
  border: none;
  color: var(--text2);
  font-size: 30rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  line-height: 1;
  min-width: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-icon {
  font-size: 28rpx;
}

.nav-btn::after { border: none; }

/* 骨架屏 */
.skeleton-wrap {
  padding: 160rpx 48rpx 0;
}

/* 阅读区 */
.reader-scroll {
  height: calc(100vh - var(--status-bar-height, 44px) - 44px - env(safe-area-inset-bottom, 0px));
  padding: 40rpx 40rpx calc(140px + env(safe-area-inset-bottom, 0px));
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 章节头部 */
.chapter-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.ch-title {
  display: block;
  font-size: 44rpx;
  color: var(--accent2);
  font-weight: bold;
  margin-bottom: 16rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

.ch-author {
  display: block;
  color: var(--text2);
  font-size: 30rpx;
}

/* 摘要卡片 */
.summary-card {
  background: var(--card);
  border-left: 8rpx solid var(--accent);
  padding: 24rpx 32rpx;
  margin-bottom: 48rpx;
  border-radius: 0 16rpx 16rpx 0;
  font-size: 28rpx;
  color: var(--text2);
  line-height: 1.7;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 模式切换 */
.mode-switch {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin: 24rpx 0 40rpx;
}

.mode-btn {
  padding: 16rpx 40rpx;
  border: 1px solid var(--border);
  border-radius: 40rpx;
  background: var(--bg);
  color: var(--text2);
  font-size: 28rpx;
  line-height: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-btn::after { border: none; }

.mode-btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* 图片 */
.image-gallery {
  margin: 48rpx 0;
  text-align: center;
}

.img-item {
  display: inline-block;
  margin: 16rpx;
}

.gallery-img {
  max-width: 360rpx;
  border-radius: 12rpx;
  box-shadow: var(--shadow);
}

/* ==================== 逐句模式 ==================== */
.sentence-container {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-wrap: break-word;
}

.sent-block {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 20rpx 20rpx 12rpx;
  border-radius: 8rpx;
  border-left: 6rpx solid transparent;
  position: relative;
  font-size: inherit;
  line-height: inherit;
  word-break: break-all;
  overflow-wrap: break-word;
  min-height: 88rpx;
}

.sent-block:active {
  background: var(--bg2);
}

.sent-block.tts-active {
  background: var(--highlight);
  border-left-color: var(--ttsHighlight);
}

/* 移除旧的书签/笔记伪元素标记 */
.sent-block.bookmarked::before { display: none; }
.sent-block.has-note::after { display: none; }

.sent-text {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

/* 连续模式 */
.continuous-container {
  font-size: inherit;
  line-height: 1.9;
  width: 100%;
  box-sizing: border-box;
  word-break: break-all;
  overflow-wrap: break-word;
}

.cont-para {
  text-indent: 2em;
  margin-bottom: 24rpx;
}

.cont-sent {
  transition: background 0.25s, color 0.25s;
  border-radius: 4rpx;
  padding: 6rpx 4rpx;
  display: inline;
}

.cont-sent.tts-active {
  background: var(--ttsHighlight);
  color: inherit;
  box-shadow: 0 0 0 4rpx var(--ttsHighlight);
}

/* 连续模式书签/笔记视觉标记 */
.cont-bookmarked {
  border-bottom: 4rpx solid var(--accent);
}

.cont-has-note {
  background: linear-gradient(to bottom, transparent 60%, rgba(212,148,90,0.15) 60%);
}

/* TTS 播放条 */
.tts-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(30,25,18,0.92);
  backdrop-filter: blur(12px);
  padding: 8px 24rpx calc(8px + env(safe-area-inset-bottom, 0px));
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 -4rpx 40rpx rgba(0,0,0,0.25);
  border-top: 1px solid rgba(255,255,255,0.08);
  flex-wrap: nowrap;
  overflow-x: auto;
}

.tts-progress-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 4rpx;
  background: var(--accent);
  transition: width 0.3s;
  border-radius: 0 2rpx 0 0;
}

.tts-slider {
  position: absolute;
  top: -26rpx;
  left: 0;
  right: 0;
  height: 40rpx;
  z-index: 5;
  opacity: 0.6;
  margin: 0;
}

/* 底部 TTS 栏中书签/笔记入口 */
.tts-sidebar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  line-height: 1;
  border: none;
}

.tts-sidebar-btn::after { border: none; }
.tts-sidebar-btn:active { background: rgba(255,255,255,0.2); }

.tts-play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  line-height: 1;
  border: none;
}

.tts-play-btn::after { border: none; }

.tts-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

.tts-ctrl-btn {
  background: none;
  border: none;
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  padding: 8rpx 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  line-height: 1;
  min-width: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tts-ctrl-btn::after { border: none; }

.tts-progress-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 24rpx;
  bottom: 220rpx;
  z-index: 150;
}

.fab-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--card);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
  padding: 0;
  line-height: 1;
}

.fab-btn::after { border: none; }

.tts-fab-btn {
  margin-bottom: 16rpx;
}

.tts-fab-btn.playing {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* ==================== 通用底部遮罩 ==================== */
.sheet-mask {
  position: fixed; inset: 0; z-index: 250;
  background: rgba(0,0,0,0.4);
  animation: fadeIn 0.25s;
}

/* 保留旧 sidebar-mask 兼容 */
.sidebar-mask {
  position: fixed; inset: 0; z-index: 250;
  background: rgba(0,0,0,0.4);
}

/* ==================== 底部抽屉：书签/笔记列表 ==================== */
.bottom-sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 260;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
  display: flex; flex-direction: column;
  box-shadow: 0 -4rpx 32rpx rgba(0,0,0,0.15);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom, 10px);
}

.bottom-sheet.open { transform: translateY(0); }

.sheet-handle {
  display: flex; justify-content: center;
  padding: 16rpx 0 8rpx;
}

.sheet-handle-bar {
  width: 80rpx; height: 8rpx;
  border-radius: 4rpx;
  background: var(--border);
}

.sheet-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
  padding: 0 32rpx;
}

.sheet-tab {
  flex: 1; padding: 24rpx 8rpx;
  border: none; background: none;
  font-size: 30rpx; color: var(--text2);
  border-bottom: 4rpx solid transparent;
  line-height: 1;
  min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
}

.sheet-tab::after { border: none; }
.sheet-tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 600;
}

.sheet-content {
  flex: 1;
  padding: 8rpx 0;
  overflow-y: auto;
}

.sheet-item {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  position: relative;
}

.sheet-item-inner {
  flex: 1; min-width: 0;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--border);
  transition: transform 0.25s;
  background: var(--card);
}

.sheet-item-title {
  display: block; font-size: 28rpx;
  color: var(--text); margin-bottom: 6rpx;
}

.sheet-item-meta {
  display: block; font-size: 24rpx;
  color: var(--text2);
}

/* 左滑删除按钮 */
.sheet-item-del {
  position: absolute; right: 0; top: 0; bottom: 0;
  width: 140rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  transform: translateX(140rpx);
  transition: transform 0.25s;
}

.sheet-item.swiped .sheet-item-del {
  transform: translateX(0);
}

.sheet-item.swiped .sheet-item-inner {
  transform: translateX(-140rpx);
}

.sidebar-empty {
  display: block; text-align: center;
  color: var(--text2); padding: 80rpx 0;
  font-size: 28rpx;
}

/* ==================== 长按操作菜单 (ActionSheet) ==================== */
.action-sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 270;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 32rpx rgba(0,0,0,0.15);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.action-sheet.open { transform: translateY(0); }

.action-sheet-header {
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1px solid var(--border);
}

.action-sheet-preview {
  font-size: 26rpx; color: var(--text2);
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
  line-height: 1.5;
}

.action-sheet-actions {
  padding: 8rpx 0;
}

.action-sheet-btn {
  display: flex; align-items: center; gap: 20rpx;
  width: 100%; padding: 28rpx 32rpx;
  border: none; background: none;
  font-size: 30rpx; color: var(--text);
  line-height: 1;
  text-align: left;
  min-height: 88rpx;
}

.action-sheet-btn::after { border: none; }
.action-sheet-btn:active { background: var(--bg2); }

.action-sheet-icon {
  font-size: 36rpx; width: 48rpx;
  text-align: center; flex-shrink: 0;
}

.action-sheet-cancel {
  width: 100%; padding: 28rpx;
  border: none; background: none;
  border-top: 8rpx solid var(--bg2);
  font-size: 30rpx; color: var(--text2);
  text-align: center; line-height: 1;
  min-height: 88rpx;
}

.action-sheet-cancel::after { border: none; }
.action-sheet-cancel:active { background: var(--bg2); }

/* ==================== 底部半屏笔记编辑器 ==================== */
.note-editor-sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 280;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  min-height: 50vh;
  display: flex; flex-direction: column;
  box-shadow: 0 -4rpx 32rpx rgba(0,0,0,0.15);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.note-editor-sheet.open { transform: translateY(0); }

.note-editor-handle {
  display: flex; justify-content: center;
  padding: 12rpx 0;
}

.note-editor-handle-bar {
  width: 80rpx; height: 8rpx;
  border-radius: 4rpx;
  background: var(--border);
}

.note-editor-header {
  padding: 8rpx 28rpx 16rpx;
  display: flex; align-items: center; gap: 12rpx;
}

.note-editor-title {
  font-size: 32rpx; color: var(--text); font-weight: 600;
  flex: 1;
}

.note-editor-context {
  font-size: 26rpx; color: var(--text2);
}

.note-editor-close {
  background: none; border: none;
  color: var(--text2); font-size: 36rpx;
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0; line-height: 1; border-radius: 12rpx;
}

.note-editor-close::after { border: none; }
.note-editor-close:active { background: var(--bg2); }

.note-editor-quote {
  padding: 16rpx 28rpx;
  font-size: 26rpx; color: var(--text2);
  background: var(--bg2);
  border-left: 6rpx solid var(--accent);
  margin: 0 28rpx;
  border-radius: 0 8rpx 8rpx 0;
  font-style: italic;
  line-height: 1.6;
}

.note-editor-textarea {
  flex: 1;
  margin: 20rpx 28rpx;
  padding: 24rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  width: auto;
  min-height: 200rpx;
  line-height: 1.7;
}

.note-editor-actions {
  display: flex; gap: 16rpx;
  padding: 0 28rpx 24rpx;
}

.note-editor-btn {
  flex: 1;
  padding: 24rpx 0; border-radius: 16rpx;
  font-size: 30rpx; border: 1px solid var(--border);
  background: var(--bg); color: var(--text2);
  line-height: 1;
  min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
}

.note-editor-btn::after { border: none; }
.note-btn-save {
  background: var(--accent); color: #fff;
  border-color: var(--accent); font-weight: 600;
}

/* 旧笔记编辑器（保留兼容，废弃） */
.note-mask { display: none; }
.note-editor { display: none; }

/* AI 面板 */
.ai-panel {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 190;
  background: var(--card);
  border-top: 1px solid var(--border);
  transition: transform 0.3s;
  transform: translateY(calc(100% - 88rpx));
  max-height: 50vh;
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

.ai-panel.open { transform: translateY(0); }

.ai-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx; height: 88rpx;
}

.ai-header-title {
  font-size: 30rpx; color: var(--accent2); font-weight: bold;
}

.ai-header-right {
  display: flex; align-items: center; gap: 12rpx;
}

.ai-settings-btn {
  background: none; border: none; color: var(--text2);
  font-size: 28rpx; padding: 4rpx 8rpx; line-height: 1;
  min-width: 64rpx; min-height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}
.ai-settings-btn::after { border: none; }

.ai-arrow { color: var(--text2); font-size: 24rpx; }

.ai-input-area {
  display: flex; gap: 12rpx; padding: 0 32rpx 20rpx;
}

.ai-input {
  flex: 1; padding: 16rpx 24rpx;
  border: 1px solid var(--border); border-radius: 40rpx;
  background: var(--bg); color: var(--text); font-size: 28rpx;
}

.ai-send-btn {
  padding: 16rpx 32rpx; border-radius: 40rpx;
  border: none; background: var(--accent); color: #fff;
  font-size: 28rpx; line-height: 1;
  min-width: 100rpx; min-height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}
.ai-send-btn::after { border: none; }

.ai-response {
  padding: 0 32rpx 24rpx;
  font-size: 28rpx; line-height: 1.7; color: var(--text);
  white-space: pre-wrap; max-height: 40vh;
}

.ai-loading {
  text-align: center; color: var(--accent); font-size: 28rpx; padding: 20rpx;
}

.ai-guide {
  padding: 24rpx 32rpx; text-align: center;
  color: var(--text2); font-size: 26rpx; line-height: 1.8;
}

.ai-guide-link {
  display: block; color: var(--accent); margin-top: 8rpx;
}

/* AI 设置弹窗 */
.ai-modal-mask {
  position: fixed; inset: 0; z-index: 500;
  background: rgba(0,0,0,0.5);
}

.ai-modal {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  z-index: 510; background: var(--card); border-radius: 24rpx;
  padding: 40rpx; width: 600rpx; box-shadow: 0 8px 40px rgba(0,0,0,0.2);
}

.ai-modal-title {
  display: block; font-size: 34rpx; color: var(--accent2);
  font-weight: bold; margin-bottom: 24rpx;
}

.ai-modal-input {
  width: 100%; padding: 20rpx 24rpx;
  border: 1px solid var(--border); border-radius: 16rpx;
  background: var(--bg); color: var(--text);
  font-size: 26rpx; font-family: monospace; margin-bottom: 20rpx;
  box-sizing: border-box;
}

.ai-modal-hint {
  display: block; font-size: 24rpx; color: var(--text2);
  margin-bottom: 28rpx; line-height: 1.6; white-space: pre-line;
}

.ai-modal-actions {
  display: flex; gap: 16rpx; justify-content: flex-end;
}

.ai-modal-btn {
  padding: 16rpx 36rpx; border-radius: 12rpx;
  border: 1px solid var(--border); background: var(--bg);
  color: var(--text2); font-size: 28rpx; line-height: 1;
}
.ai-modal-btn::after { border: none; }
.ai-modal-btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }

/* Toast */
.toast {
  position: fixed; top: 120rpx; left: 50%; transform: translateX(-50%);
  z-index: 600; background: var(--accent2); color: #fff;
  padding: 16rpx 36rpx; border-radius: 40rpx; font-size: 28rpx;
}

/* ==================== 动画关键帧 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ==================== 读设置手动覆盖 ==================== */
/* 字号 */
.reader-root.size-sm { font-size: 28rpx; }
.reader-root.size-lg { font-size: 40rpx; }

/* 行距 */
.reader-root.spacing-tight { line-height: 1.5; }
.reader-root.spacing-wide { line-height: 2.2; }

/* 暗色模式手动覆盖 */
.reader-root.dark-manual {
  --bg: #1a1a2e;
  --bg2: #16213e;
  --text: #e0d7c6;
  --text2: #a09080;
  --accent: #d4945a;
  --accent2: #e0a070;
  --card: #1f2940;
  --border: #2a3550;
  --highlight: #3a3520;
  --ttsHighlight: #b8860b;
  --navBg: rgba(26,26,46,0.95);
  --shadow: 0 2px 12px rgba(0,0,0,0.3);
  --skeletonBase: #2a3550;
  --skeletonShine: #354060;
  --noteBadge: #e0a070;
  --coverBg: linear-gradient(135deg, #0f0f1a, #1a1a2e, #2a1a0a, #1a0a00);
}
